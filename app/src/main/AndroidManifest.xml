<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only to download the speech model once (SpeechModel.install); audio and text
         never leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceInbox">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opens the app recording with one shortcut: the target of home-screen shortcuts
             and widgets. Its own task, so every tap reaches MainActivity (see RecordActivity). -->
        <activity
            android:name=".ui.RecordActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_record"
            android:label="@string/record_label"
            android:noHistory="true"
            android:taskAffinity="t7helpers.voiceinbox.record"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="t7helpers.voiceinbox.action.RECORD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Picks the shortcut of a Record widget when it is placed. -->
        <activity
            android:name=".ui.RecordWidgetSetup"
            android:exported="true"
            android:label="@string/record_label"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ui.RecordWidget"
            android:exported="true"
            android:label="@string/record_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/record_widget" />
        </receiver>
    </application>
</manifest>
