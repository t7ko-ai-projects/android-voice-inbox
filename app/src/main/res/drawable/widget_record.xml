<?xml version="1.0" encoding="utf-8"?>
<!-- The Record icon for the widget: RemoteViews cannot mask an adaptive icon, so a red circle with the microphone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_record_background" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
