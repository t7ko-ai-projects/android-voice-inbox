<?xml version="1.0" encoding="utf-8"?>
<!-- One home-screen cell: a Record button for one shortcut, chosen when it is placed. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:configure="t7helpers.voiceinbox.ui.RecordWidgetSetup"
    android:initialLayout="@layout/record_widget"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:previewLayout="@layout/record_widget"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
